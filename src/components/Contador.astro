---
// ContadorRegresivo.astro
---

<section class="relative w-full pt-1 pb-8 px-6 overflow-hidden">

    <!-- Hojas decorativas (copia de NombresFlores) detrás de toda la tarjeta, a la derecha -->
    <div id="hojas-contador" class="absolute top-1/2 right-0 sm:right-1 md:right-2 -translate-y-1/2 w-12 sm:w-14 md:w-16 z-0 pointer-events-none">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain scale-x-[-1]"
                loading="lazy"
                decoding="async"
            />
    </div>

    <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center text-center">

        <!-- Línea superior elegante -->
        <p id="contador-overline" class="font-serif font-light text-[#A24F35] text-xs sm:text-sm tracking-normal uppercase mb-2">
            Faltan para nuestro gran día
        </p>

        <!-- Divisor ornamental -->
        <div id="contador-divisor" class="flex items-center gap-4 mb-6">
            <span class="block w-10 sm:w-16 h-px bg-gradient-to-r from-transparent to-[#A24F35]/70"></span>
            <span class="text-[#A24F35] text-sm leading-none">&#10070;</span>
            <span class="block w-10 sm:w-16 h-px bg-gradient-to-l from-transparent to-[#A24F35]/70"></span>
        </div>

        <!-- Contenedor del contador -->
        <div
            id="contador-container"
            class="relative z-10 w-full rounded-2xl px-3 sm:px-8 py-8 sm:py-10 overflow-hidden shadow-2xl"
        >

            <!-- Marco interior fino, el mismo detalle de las tarjetas de dirección -->
            <span class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#EFE0D3]/35 rounded-xl"></span>

            <div class="relative grid grid-cols-4 gap-0">

                <!-- DÍAS -->
                <div id="dias-box" class="relative flex flex-col items-center justify-center px-1 sm:px-2">
                    <div class="font-serif font-light tabular-nums text-4xl sm:text-5xl md:text-6xl text-[#FBF5EF] leading-none" id="dias">
                        00
                    </div>
                    <span class="block w-5 sm:w-7 h-px bg-[#EFE0D3]/40 my-3"></span>
                    <span class="text-[10px] sm:text-xs text-[#EFE0D3]/85 uppercase tracking-[0.3em] font-serif leading-none">
                        Días
                    </span>
                </div>

                <!-- HORAS -->
                <div id="horas-box" class="relative flex flex-col items-center justify-center px-1 sm:px-2">
                    <!-- Separador que se desvanece en los extremos -->
                    <span class="pointer-events-none absolute left-0 top-1/2 -translate-y-1/2 w-px h-16 sm:h-20 bg-gradient-to-b from-transparent via-[#EFE0D3]/45 to-transparent"></span>
                    <div class="font-serif font-light tabular-nums text-4xl sm:text-5xl md:text-6xl text-[#FBF5EF] leading-none" id="horas">
                        00
                    </div>
                    <span class="block w-5 sm:w-7 h-px bg-[#EFE0D3]/40 my-3"></span>
                    <span class="text-[10px] sm:text-xs text-[#EFE0D3]/85 uppercase tracking-[0.3em] font-serif leading-none">
                        Horas
                    </span>
                </div>

                <!-- MINUTOS -->
                <div id="minutos-box" class="relative flex flex-col items-center justify-center px-1 sm:px-2">
                    <span class="pointer-events-none absolute left-0 top-1/2 -translate-y-1/2 w-px h-16 sm:h-20 bg-gradient-to-b from-transparent via-[#EFE0D3]/45 to-transparent"></span>
                    <div class="font-serif font-light tabular-nums text-4xl sm:text-5xl md:text-6xl text-[#FBF5EF] leading-none" id="minutos">
                        00
                    </div>
                    <span class="block w-5 sm:w-7 h-px bg-[#EFE0D3]/40 my-3"></span>
                    <span class="text-[10px] sm:text-xs text-[#EFE0D3]/85 uppercase tracking-[0.3em] font-serif leading-none">
                        Min.
                    </span>
                </div>

                <!-- SEGUNDOS -->
                <div id="segundos-box" class="relative flex flex-col items-center justify-center px-1 sm:px-2">
                    <span class="pointer-events-none absolute left-0 top-1/2 -translate-y-1/2 w-px h-16 sm:h-20 bg-gradient-to-b from-transparent via-[#EFE0D3]/45 to-transparent"></span>
                    <div class="font-serif font-light tabular-nums text-4xl sm:text-5xl md:text-6xl text-[#FBF5EF] leading-none" id="segundos">
                        00
                    </div>
                    <span class="block w-5 sm:w-7 h-px bg-[#EFE0D3]/40 my-3"></span>
                    <span class="text-[10px] sm:text-xs text-[#EFE0D3]/85 uppercase tracking-[0.3em] font-serif leading-none">
                        Seg.
                    </span>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES Y CONTADOR CON GSAP                          -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {

        // ═══ HOJAS DECORATIVAS - Entrada lateral desde su propio lado ═══
        gsap.fromTo(
            "#hojas-contador",
            { opacity: 0, x: 120, rotation: 6 },
            {
                opacity: 1,
                x: 0,
                rotation: 0,
                duration: 1.3,
                ease: "power3.out",
                scrollTrigger: { trigger: "#hojas-contador", start: "top 92%", toggleActions: "play none none reverse" }
            }
        );
        console.log("⏰ Iniciando contador regresivo...");

        // Fecha objetivo: 3 de octubre de 2026 a las 09:00 (ceremonia religiosa)
        const fechaObjetivo = new Date("2026-10-03T09:00:00").getTime();

        // Elementos del DOM
        const diasEl = document.getElementById("dias");
        const horasEl = document.getElementById("horas");
        const minutosEl = document.getElementById("minutos");
        const segundosEl = document.getElementById("segundos");

        // Función para actualizar el contador
        function actualizarContador() {
            const ahora = new Date().getTime();
            const diferencia = fechaObjetivo - ahora;

            if (diferencia <= 0) {
                // Si ya pasó la fecha
                diasEl.textContent = "00";
                horasEl.textContent = "00";
                minutosEl.textContent = "00";
                segundosEl.textContent = "00";
                return;
            }

            // Calcular tiempo restante
            const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
            const horas = Math.floor((diferencia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutos = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));
            const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);

            // Actualizar el DOM con formato de dos dígitos
            diasEl.textContent = dias.toString().padStart(2, "0");
            horasEl.textContent = horas.toString().padStart(2, "0");
            minutosEl.textContent = minutos.toString().padStart(2, "0");
            segundosEl.textContent = segundos.toString().padStart(2, "0");

            // Animación en los segundos cada vez que cambian
            gsap.fromTo(
                segundosEl,
                { scale: 1.2, color: "#FFFFFF" },
                { scale: 1, color: "#FBF5EF", duration: 0.3, ease: "power2.out" }
            );
        }

        // Actualizar cada segundo
        actualizarContador();
        setInterval(actualizarContador, 1000);

        // ═══ ANIMACIÓN DE ENTRADA CON SCROLL ═══
        gsap.fromTo(
            "#contador-container",
            { opacity: 0, scale: 0.8, y: 50 },
            {
                opacity: 1,
                scale: 1,
                y: 0,
                duration: 1,
                ease: "back.out(1.4)",
                scrollTrigger: {
                    trigger: "#contador-container",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ ANIMACIÓN DE CADA CAJA DE NÚMERO ═══
        gsap.fromTo(
            "#dias-box, #horas-box, #minutos-box, #segundos-box",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                stagger: 0.15,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#contador-container",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.5
            }
        );

        // ═══ LÍNEA SUPERIOR Y DIVISOR ═══
        gsap.fromTo(
            "#contador-overline",
            { opacity: 0, y: -20, letterSpacing: "0.3em" },
            {
                opacity: 1,
                y: 0,
                letterSpacing: "0em",
                duration: 0.9,
                ease: "power2.out",
                scrollTrigger: { trigger: "#contador-overline", start: "top 85%", toggleActions: "play none none reverse" }
            }
        );

        gsap.fromTo(
            "#contador-divisor",
            { opacity: 0, scaleX: 0.4 },
            {
                opacity: 1,
                scaleX: 1,
                duration: 0.8,
                ease: "power2.out",
                delay: 0.2,
                scrollTrigger: { trigger: "#contador-overline", start: "top 85%", toggleActions: "play none none reverse" }
            }
        );

        console.log("✨ Contador regresivo iniciado!");
    });
</script>

<style>
    /* Transiciones suaves */
    #contador-container {
        transition: all 0.3s ease;
    }

    /* Card en terracota plano, igual que el del pase: color liso,
       sin degradados ni texturas. La sombra la pone shadow-2xl. */
    #contador-container {
        background: #A24F35;
    }

    /* Efecto hover en las cajas */
    #dias-box:hover,
    #horas-box:hover,
    #minutos-box:hover,
    #segundos-box:hover {
        transform: translateY(-5px);
    }
</style>