---
// ComponenteCeremonia.astro (Ceremonia Religiosa)
---

<section class="relative bg-[#FBF5EF] w-full py-4 px-6 overflow-hidden">

    <!-- Hojas decorativas a la izquierda -->
    <div id="hojas-iglesia-izq" class="pointer-events-none absolute top-1/2 -left-6 sm:-left-7 md:-left-8 -translate-y-1/2 w-16 sm:w-20 md:w-24 z-0">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain"
                loading="lazy"
                decoding="async"
            />
    </div>

    <div class="relative z-10 max-w-md mx-auto">

        <!-- Tarjeta con borde redondeado -->
        <div
            id="iglesia-card"
            class="relative border border-[#A24F35]/60 rounded-3xl p-8 sm:p-10 bg-white shadow-lg text-center overflow-hidden"
        >

            <!-- Borde interior fino (detalle elegante) -->
            <span class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#A24F35]/25 rounded-2xl"></span>

            <div class="relative">

                <!-- Título "Ceremonia Religiosa" -->
                <div id="iglesia-titulo" class="mb-2">
                    <h3 class="font-great-vibes text-[clamp(2.1rem,8.8vw,3.5rem)] leading-tight text-[#A24F35] tracking-wide whitespace-nowrap">
                        Ceremonia Religiosa
                    </h3>
                </div>

                <!-- Divisor ornamental -->
                <div class="flex items-center justify-center gap-3 mb-5">
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#A24F35]/70"></span>
                    <span class="w-1.5 h-1.5 rotate-45 bg-[#3B2A22]"></span>
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#A24F35]/70"></span>
                </div>

                <!-- Icono de iglesia -->
                <div id="iglesia-icono" class="mb-5 flex justify-center">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center">
                        <div role="img" aria-label="Iglesia" class="w-full h-full" style="background-color: #A24F35; -webkit-mask: url('/imagenes/iglesia.png') center / contain no-repeat; mask: url('/imagenes/iglesia.png') center / contain no-repeat;"></div>
                    </div>
                </div>

                <!-- Nombre de la iglesia -->
                <div id="iglesia-nombre" class="mb-3">
                    <p class="text-[#A24F35] text-sm sm:text-base md:text-lg font-serif tracking-[0.12em] leading-snug">
                        CATEDRAL<br />“NUESTRA SEÑORA DE LA CANDELARIA”
                    </p>
                </div>

                <!-- Dirección -->
                <div id="iglesia-direccion" class="mb-5">
                    <p class="text-[#3B2A22] text-sm sm:text-base md:text-lg font-serif tracking-[0.08em] leading-relaxed">
                        Av. Caquingora #3137, Zona Cosmos 79<br />(lado Hospital del Sur)
                    </p>
                </div>

                <!-- Hora -->
                <div id="iglesia-hora" class="mb-6">
                    <p class="text-sm sm:text-base md:text-lg text-[#3B2A22] uppercase tracking-[0.25em] font-serif mb-2">Hora</p>
                    <p class="text-[#A24F35] text-[clamp(1.35rem,5.5vw,1.8rem)] font-serif tracking-wide leading-none">
                        09:00
                    </p>
                </div>

                <!-- Botón "VER UBICACIÓN" -->
                <div id="iglesia-boton">
                    <a
                        href="https://maps.app.goo.gl/xat9zTaZuzUheb6BA"
                        target="_blank"
                        rel="noopener"
                        class="group relative inline-block bg-[#A24F35] text-[#FBF5EF] px-9 py-3 rounded-lg text-sm sm:text-base font-serif uppercase tracking-[0.2em] hover:bg-[#7B3823] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    >
                        <span class="pointer-events-none absolute inset-1.5 rounded border border-white/30 transition-all duration-300 group-hover:inset-[7px]"></span>
                        <span class="relative">Ver ubicación</span>
                    </a>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {

        // ═══ HOJAS DECORATIVAS - Entrada lateral desde su propio lado ═══
        gsap.fromTo(
            "#hojas-iglesia-izq",
            { opacity: 0, x: -120, rotation: -6 },
            {
                opacity: 1,
                x: 0,
                rotation: 0,
                duration: 1.3,
                ease: "power3.out",
                scrollTrigger: { trigger: "#hojas-iglesia-izq", start: "top 92%", toggleActions: "play none none reverse" }
            }
        );
        console.log("⛪ Iniciando animaciones de ceremonia religiosa...");

        const st = { trigger: "#iglesia-card", start: "top 80%", toggleActions: "play none none reverse" };

        // ═══ TARJETA PRINCIPAL ═══
        gsap.fromTo(
            "#iglesia-card",
            { opacity: 0, scale: 0.8, y: 50 },
            { opacity: 1, scale: 1, y: 0, duration: 1, ease: "back.out(1.4)", scrollTrigger: st }
        );

        // ═══ ICONO DE IGLESIA ═══
        gsap.fromTo(
            "#iglesia-icono",
            { opacity: 0, scale: 0.5, rotation: -10 },
            { opacity: 1, scale: 1, rotation: 0, duration: 0.8, ease: "back.out(1.7)", scrollTrigger: st, delay: 0.3 }
        );

        // ═══ TÍTULO ═══
        gsap.fromTo(
            "#iglesia-titulo",
            { opacity: 0, y: -20 },
            { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", scrollTrigger: st, delay: 0.6 }
        );

        // ═══ HORA ═══
        gsap.fromTo(
            "#iglesia-hora",
            { opacity: 0, scale: 0.7 },
            { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(1.5)", scrollTrigger: st, delay: 0.9 }
        );

        // ═══ NOMBRE DE LA IGLESIA ═══
        gsap.fromTo(
            "#iglesia-nombre",
            { opacity: 0, y: 20 },
            { opacity: 1, y: 0, duration: 0.6, ease: "power2.out", scrollTrigger: st, delay: 1.2 }
        );

        // ═══ BOTÓN "VER UBICACIÓN" ═══
        gsap.fromTo(
            "#iglesia-boton",
            { opacity: 0, y: 20 },
            { opacity: 1, y: 0, duration: 0.6, ease: "power2.out", scrollTrigger: st, delay: 1.5 }
        );

        console.log("✨ Animaciones de ceremonia religiosa completadas!");
    });
</script>

<style>
    /* Transiciones suaves en la tarjeta */
    #iglesia-card {
        transition: all 0.3s ease;
    }

    #iglesia-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    /* Efecto hover en el título */
    #iglesia-titulo:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    /* Animación del botón */
    #iglesia-boton a:active {
        transform: scale(0.95);
    }
</style>
