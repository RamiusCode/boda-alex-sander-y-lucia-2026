---
// Portada.astro
---

<section id="portada-bienvenida" class="fixed inset-0 w-full h-screen bg-[#FBF5EF] z-50 flex items-center justify-center overflow-hidden">
    
    <!-- Decoración superior izquierda - Terracota -->
    <div class="absolute top-0 left-0 w-40 md:w-36 lg:w-40 opacity-90 animate-fade-in-down">
        <img src="/imagenes/terracota.webp" alt="Flores decorativas" class="w-full h-auto" />
    </div>

    <!-- Decoración inferior derecha - Terracota (rotada 180°) -->
    <div class="absolute bottom-0 right-0 w-40 md:w-36 lg:w-40 opacity-90 animate-fade-in-up">
        <img src="/imagenes/terracota.webp" alt="Flores decorativas" class="w-full h-auto rotate-180" />
    </div>

    <!-- Contenido principal -->
    <div class="relative z-10 flex flex-col items-center justify-center px-6 py-6 w-full max-w-md">

        <!-- Frase superior ornamental -->
        <div id="frase-superior" class="flex items-center gap-3 sm:gap-4 mb-2">
            <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#A24F35]/60"></span>
            <p class="font-serif text-[clamp(0.9rem,4.2vw,1.35rem)] leading-none uppercase tracking-[0.3em] text-[#7B3823] whitespace-nowrap">
                Nuestra boda
            </p>
            <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#A24F35]/60"></span>
        </div>

        <!-- Marco con flores y nombres -->
        <div id="contenedor-principal" class="relative w-full flex justify-center items-center">

            <!-- Imagen del marco con flores (centro.webp) -->
            <div class="relative w-[21rem] h-[24rem] sm:w-96 sm:h-[28rem] md:w-[26rem] md:h-[32rem]">
                <img
                    id="marco-flores"
                    src="/imagenes/centro.webp"
                    alt="Marco decorativo"
                    class="w-full h-full object-contain"
                />

                <!-- Nombres de los novios DENTRO del marco -->
                <div class="absolute inset-0 flex flex-col items-center justify-center px-10 sm:px-12">
                    <h2 id="nombre-john" class="font-great-vibes text-[clamp(1.9rem,9vw,2.75rem)] leading-tight text-[#A24F35] tracking-wide text-center whitespace-nowrap">
                        Alex Sander
                    </h2>

                    <div id="ampersand" class="flex items-center gap-2 my-1.5">
                        <div class="w-8 sm:w-10 h-px bg-gradient-to-r from-transparent to-[#A24F35]/70"></div>
                        <span class="text-[#A24F35] text-xl sm:text-2xl font-charm italic">y</span>
                        <div class="w-8 sm:w-10 h-px bg-gradient-to-l from-transparent to-[#A24F35]/70"></div>
                    </div>

                    <h2 id="nombre-damarys" class="font-great-vibes text-[clamp(1.9rem,9vw,2.75rem)] leading-tight text-[#A24F35] tracking-wide text-center whitespace-nowrap">
                        Lucía
                    </h2>
                </div>
            </div>

        </div>

        <!-- Fecha del evento (una sola línea) -->
        <div id="bloque-fecha" class="-mt-1 flex flex-col items-center">

            <!-- Divisor ornamental -->
            <div class="flex items-center justify-center gap-3 mb-3">
                <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#A24F35]/60"></span>
                <span class="text-[#A24F35] text-[0.7rem] leading-none">&#10070;</span>
                <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#A24F35]/60"></span>
            </div>

            <p class="font-serif text-[0.7rem] sm:text-sm uppercase tracking-[0.22em] text-[#7B3823] whitespace-nowrap">
                Sábado 03 de Octubre de 2026
            </p>

        </div>

        <!-- Botón INGRESAR -->
        <div class="mt-6 flex justify-center">
            <button
                id="btn-ingresar"
                class="group relative px-9 py-3 bg-[#A24F35] hover:bg-[#7B3823] text-[#FBF5EF] font-serif text-sm sm:text-base uppercase tracking-[0.2em] rounded-lg shadow-xl transition-all duration-300 hover:scale-105 hover:shadow-2xl overflow-hidden"
            >
                <!-- Filete interior elegante -->
                <span class="pointer-events-none absolute inset-1.5 rounded border border-[#FBF5EF]/30 transition-all duration-300 group-hover:inset-[7px]"></span>

                <!-- Efecto brillante al hacer hover -->
                <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-[#FBF5EF]/25 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></span>

                <span class="relative z-10">Ingresar</span>
            </button>
        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";

    document.addEventListener('DOMContentLoaded', () => {
        console.log("💐 Iniciando animaciones de portada...");

        // ═══ FRASE SUPERIOR "NUESTRA BODA" ═══
        gsap.fromTo(
            "#frase-superior",
            { opacity: 0, y: -15 },
            { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 0.2 }
        );

        // ═══ MARCO CON FLORES - Scale desde el centro ═══
        gsap.fromTo(
            "#marco-flores",
            { opacity: 0, scale: 0.3, rotation: -5 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 1.2,
                ease: "back.out(1.5)",
                delay: 0.3
            }
        );

        // ═══ ROTACIÓN SUAVE DEL MARCO (loop infinito muy sutil) ═══
        gsap.to("#marco-flores", {
            rotation: 2,
            duration: 4,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 1.5
        });

        // ═══ NOMBRE JOHN - Letra por letra ═══
        const textoJohn = "Alex Sander";
        const contenedorJohn = document.getElementById("nombre-john");
        if (contenedorJohn) {
            contenedorJohn.innerHTML = textoJohn
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-animada" style="
                            opacity: 0; 
                            display: inline-block; 
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra === " " ? "&nbsp;" : letra}</span>`
                )
                .join("");

            gsap.to("#nombre-john .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.08, from: "start" },
                delay: 0.8
            });
        }

        // ═══ SÍMBOLO Y con líneas - Scale con bounce ═══
        gsap.fromTo(
            "#ampersand",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(2)", delay: 1.3 }
        );

        // ═══ NOMBRE DAMARYS - Letra por letra ═══
        const textoDamarys = "Lucía";
        const contenedorDamarys = document.getElementById("nombre-damarys");
        if (contenedorDamarys) {
            contenedorDamarys.innerHTML = textoDamarys
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-animada" style="
                            opacity: 0; 
                            display: inline-block; 
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra === " " ? "&nbsp;" : letra}</span>`
                )
                .join("");

            gsap.to("#nombre-damarys .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.08, from: "start" },
                delay: 1.6
            });
        }

        // ═══ "NOS CASAMOS" + FECHA ═══
        gsap.fromTo(
            "#bloque-fecha",
            { opacity: 0, y: 25 },
            { opacity: 1, y: 0, duration: 0.9, ease: "power3.out", delay: 2.0 }
        );

        // ═══ BOTÓN INGRESAR CON FUNCIONALIDAD ═══
        const btnIngresar = document.getElementById('btn-ingresar');
        const portada = document.getElementById('portada-bienvenida');

        // Animación de entrada del botón
        gsap.fromTo(
            "#btn-ingresar",
            { opacity: 0, y: 30, scale: 0.9 },
            { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "back.out(1.5)", delay: 2.5 }
        );

        btnIngresar?.addEventListener('click', () => {
            console.log("🚪 Cerrando portada...");

            // 🎵 Arrancar la música. Se hace aquí mismo, de forma síncrona y
            // sobre el <audio> directamente, porque el navegador sólo permite
            // reproducir dentro del gesto del usuario. Delegarlo a otro script
            // por medio de un evento era frágil: si ese script no había
            // registrado su listener todavía, el click se perdía sin avisar.
            const audio = document.getElementById('audio-player') as HTMLAudioElement | null;

            if (audio) {
                audio.volume = 1;
                audio.muted = false;
                audio.play()
                    .then(() => console.log("🎵 Música reproduciéndose"))
                    .catch((error) => console.warn("⚠️ El navegador bloqueó el audio:", error));
            } else {
                console.warn("⚠️ No se encontró el elemento #audio-player en la página");
            }

            // Se mantiene el evento para que el reproductor sincronice sus iconos.
            window.dispatchEvent(new Event("iniciar-musica"));

            // Animación de salida suave
            gsap.to(portada, {
                opacity: 0,
                scale: 0.95,
                duration: 0.6,
                ease: "power2.inOut",
                onComplete: () => {
                    portada?.remove();
                    // Hacer scroll suave al inicio
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    console.log("✅ Portada cerrada");
                }
            });
        });

        console.log("✨ Animaciones de portada completadas!");
    });
</script>

<style>
    /* Fuentes personalizadas */
    @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap');

    .font-great-vibes {
        font-family: 'Great Vibes', cursive;
    }

    .font-charm {
        font-family: 'Great Vibes', 'Dancing Script', cursive;
    }

    /* Animaciones de entrada */
    @keyframes fade-in-down {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 0.9;
            transform: translateY(0);
        }
    }

    @keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 0.9;
            transform: translateY(0);
        }
    }

    .animate-fade-in-down {
        animation: fade-in-down 1s ease-out forwards;
    }

    .animate-fade-in-up {
        animation: fade-in-up 1s ease-out forwards;
        animation-delay: 0.2s;
    }

    /* Efecto hover en letras animadas */
    .letra-animada {
        transition: all 0.3s ease;
        will-change: transform, opacity, filter;
        position: relative;
    }

    .letra-animada:hover {
        transform: translateY(-3px) scale(1.1) !important;
        text-shadow: 0 0 15px rgba(162, 79, 53, 0.35) !important;
    }

    /* Prevenir scroll mientras está la portada */
    body:has(#portada-bienvenida) {
        overflow: hidden;
    }

    /* Optimización de rendimiento */
    #marco-flores,
    .letra-animada {
        backface-visibility: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>