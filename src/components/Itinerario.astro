---
// Itinerario.astro - Versión con colores de boda (rojo · azul)

const eventos = [
    { titulo: "Ceremonia Religiosa", hora: "09:00", icono: "iglesia" },
    { titulo: "Recepción", hora: "15:30", icono: "recepcion" },
    { titulo: "Ceremonia Civil", hora: "16:00", icono: "civil" },
    { titulo: "Vals y Brindis", hora: "16:30", icono: "brindis" },
    { titulo: "Número Sorpresa", hora: "18:00", icono: "fiesta" },
    { titulo: "Cena", hora: "20:00", icono: "cena" },
    { titulo: "Torta", hora: "22:00", icono: "torta" },
    { titulo: "Felices por Siempre", hora: "00:00", icono: "baile" },
];
---

<section class="px-4 relative overflow-hidden py-6">

    <!-- Hojas decorativas: derecha (arriba) -->
    <div id="hojas-itinerario-der" class="pointer-events-none absolute top-[22%] -right-6 sm:-right-8 -translate-y-1/2 w-16 sm:w-20 md:w-24 z-0">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain scale-x-[-1]"
                loading="lazy"
                decoding="async"
            />
    </div>

    <!-- Hojas decorativas: izquierda (abajo) -->
    <div id="hojas-itinerario-izq" class="pointer-events-none absolute top-[75%] -left-6 sm:-left-8 -translate-y-1/2 w-16 sm:w-20 md:w-24 z-0">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain"
                loading="lazy"
                decoding="async"
            />
    </div>

    <div class="max-w-5xl mx-auto relative z-10">
        <div class="max-w-3xl mx-auto relative">
            <!-- Título -->
            <div class="text-center mb-6 titulo-itinerario opacity-0">
                <h2
                    class="font-great-vibes text-[clamp(2.1rem,8.8vw,3.5rem)] leading-tight text-[#A24F35] tracking-wide whitespace-nowrap mb-3"
                >
                    Itinerario
                </h2>
                <div class="flex items-center justify-center gap-3">
                    <div
                        class="w-16 h-[2px] bg-gradient-to-r from-transparent to-[#A24F35]"
                    >
                    </div>
                    <div class="w-2 h-2 rounded-full bg-[#3B2A22]"></div>
                    <div
                        class="w-16 h-[2px] bg-gradient-to-l from-transparent to-[#A24F35]"
                    >
                    </div>
                </div>
            </div>

            <div class="relative px-4 md:px-8">
                <!-- Línea central -->
                <div
                    class="absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[3px] bg-gradient-to-b from-[#A24F35] via-[#C0714F] to-[#A24F35] rounded-full shadow-sm linea-central opacity-0"
                >
                </div>

                <div class="space-y-0" id="eventos-container">
                    {
                        eventos.map((evento, i) => (
                            <>
                                {/* Corazón separador */}
                                <div class="flex justify-center py-1">
                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#A24F35] to-[#7B3823] flex items-center justify-center relative z-10 corazon-item shadow-md opacity-0">
                                        <svg
                                            class="w-4 h-4 text-[#FBF5EF]"
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                        >
                                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                                        </svg>
                                    </div>
                                </div>

                                {/* Evento */}
                                <div class="evento-item grid grid-cols-2 gap-4 md:gap-8 py-1 opacity-0">
                                    {i % 2 === 0 ? (
                                        <>
                                            <div class="flex flex-col items-center justify-center px-2 md:px-4 imagen-izq">
                                                <div class="w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 transform transition-transform duration-300 hover:scale-110">
                                                    <div
                                                        role="img"
                                                        aria-label={evento.titulo}
                                                        class="icono-itinerario w-full h-full"
                                                        style={`-webkit-mask: url('/imagenes/${evento.icono}.png') center / contain no-repeat; mask: url('/imagenes/${evento.icono}.png') center / contain no-repeat;`}
                                                    />
                                                </div>
                                            </div>
                                            <div class="flex flex-col items-center justify-center px-2 md:px-4 text-center texto-der">
                                                <p class="font-serif text-[#3B2A22] text-sm sm:text-base md:text-lg tracking-[0.12em] leading-snug">
                                                    {evento.titulo}
                                                </p>
                                                <p class="font-serif text-[#A24F35] text-[clamp(1.35rem,5.5vw,1.8rem)] leading-none tracking-wide mt-1">
                                                    {evento.hora}
                                                </p>
                                            </div>
                                        </>
                                    ) : (
                                        <>
                                            <div class="flex flex-col items-center justify-center px-2 md:px-4 text-center texto-izq">
                                                <p class="font-serif text-[#3B2A22] text-sm sm:text-base md:text-lg tracking-[0.12em] leading-snug">
                                                    {evento.titulo}
                                                </p>
                                                <p class="font-serif text-[#A24F35] text-[clamp(1.35rem,5.5vw,1.8rem)] leading-none tracking-wide mt-1">
                                                    {evento.hora}
                                                </p>
                                            </div>
                                            <div class="flex flex-col items-center justify-center px-2 md:px-4 imagen-der">
                                                <div class="w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 transform transition-transform duration-300 hover:scale-110">
                                                    <div
                                                        role="img"
                                                        aria-label={evento.titulo}
                                                        class="icono-itinerario w-full h-full"
                                                        style={`-webkit-mask: url('/imagenes/${evento.icono}.png') center / contain no-repeat; mask: url('/imagenes/${evento.icono}.png') center / contain no-repeat;`}
                                                    />
                                                </div>
                                            </div>
                                        </>
                                    )}
                                </div>
                            </>
                        ))
                    }

                    <!-- Corazón Final -->
                    <div class="flex justify-center py-1">
                        <div
                            class="w-8 h-8 rounded-full bg-gradient-to-br from-[#A24F35] to-[#7B3823] flex items-center justify-center relative z-10 corazon-item shadow-md opacity-0"
                        >
                            <svg
                                class="w-4 h-4 text-[#FBF5EF]"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                            >
                                <path
                                    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                ></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .font-great-vibes {
        font-family: "Great Vibes", cursive;
    }

    .evento-item p {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .evento-item:hover p:first-of-type {
        color: #A24F35;
        transform: scale(1.08);
        text-shadow: 0 2px 8px rgba(162, 79, 53, 0.3);
    }

    .corazon-item {
        filter: drop-shadow(0 4px 12px rgba(162, 79, 53, 0.5));
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .corazon-item:hover {
        transform: scale(1.2) rotate(10deg);
        filter: drop-shadow(0 8px 20px rgba(162, 79, 53, 0.7));
    }

    /* Íconos PNG teñidos con el rojo de la boda */
    .icono-itinerario {
        background-color: #A24F35;
        filter: drop-shadow(0 4px 10px rgba(162, 79, 53, 0.2));
        transition:
            filter 0.3s ease,
            transform 0.3s ease;
    }

    .icono-itinerario:hover {
        filter: drop-shadow(0 6px 16px rgba(162, 79, 53, 0.35));
    }

    .linea-central {
        box-shadow: 0 0 15px rgba(162, 79, 53, 0.3);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initItinerario = () => {
        // ═══ HOJAS DECORATIVAS - Entrada lateral desde su propio lado ═══
        gsap.fromTo(
            "#hojas-itinerario-der",
            { opacity: 0, x: 120, rotation: 6 },
            {
                opacity: 1,
                x: 0,
                rotation: 0,
                duration: 1.3,
                ease: "power3.out",
                scrollTrigger: { trigger: "#hojas-itinerario-der", start: "top 92%", toggleActions: "play none none reverse" }
            }
        );

        gsap.fromTo(
            "#hojas-itinerario-izq",
            { opacity: 0, x: -120, rotation: -6 },
            {
                opacity: 1,
                x: 0,
                rotation: 0,
                duration: 1.3,
                ease: "power3.out",
                scrollTrigger: { trigger: "#hojas-itinerario-izq", start: "top 92%", toggleActions: "play none none reverse" }
            }
        );

        // 🎯 ESTADO INICIAL - Todo oculto
        gsap.set(".titulo-itinerario", { opacity: 0, y: -30 });
        gsap.set(".linea-central", { opacity: 0, scaleY: 0 });
        gsap.set(".corazon-item", { opacity: 0, scale: 0 });
        gsap.set(".evento-item", { opacity: 0 });
        gsap.set(".imagen-izq", { x: -60 });
        gsap.set(".texto-izq", { x: -60 });
        gsap.set(".imagen-der", { x: 60 });
        gsap.set(".texto-der", { x: 60 });

        // ✨ ANIMACIÓN DEL TÍTULO (solo una vez)
        ScrollTrigger.create({
            trigger: ".titulo-itinerario",
            start: "top 85%",
            once: true,
            onEnter: () => {
                gsap.to(".titulo-itinerario", {
                    opacity: 1,
                    y: 0,
                    duration: 1.2,
                    ease: "power3.out",
                });
            },
        });

        // ✨ ANIMACIÓN DEL ITINERARIO - SE REPITE AL BAJAR/SUBIR
        ScrollTrigger.create({
            trigger: "#eventos-container",
            start: "top 80%",
            end: "top 20%",

            // Al bajar (entrar)
            onEnter: () => {
                const tl = gsap.timeline();

                // TODO AL MISMO TIEMPO (label 0)
                tl.to(
                    ".linea-central",
                    {
                        opacity: 1,
                        scaleY: 1,
                        duration: 1.5,
                        ease: "power2.out",
                        transformOrigin: "top center",
                    },
                    0,
                )

                    .to(
                        ".corazon-item",
                        {
                            opacity: 1,
                            scale: 1,
                            duration: 0.8,
                            ease: "back.out(1.7)",
                        },
                        0,
                    )

                    .to(
                        ".evento-item",
                        {
                            opacity: 1,
                            duration: 1,
                            ease: "power3.out",
                        },
                        0,
                    )

                    .to(
                        ".imagen-izq, .texto-izq",
                        {
                            x: 0,
                            duration: 1,
                            ease: "power3.out",
                        },
                        0,
                    )

                    .to(
                        ".imagen-der, .texto-der",
                        {
                            x: 0,
                            duration: 1,
                            ease: "power3.out",
                        },
                        0,
                    );
            },

            // Al subir (salir)
            onLeaveBack: () => {
                const tl = gsap.timeline();

                // Resetea TODO AL MISMO TIEMPO
                tl.to(
                    ".linea-central, .corazon-item, .evento-item",
                    {
                        opacity: 0,
                        duration: 0.4,
                        ease: "power2.in",
                    },
                    0,
                )

                    .to(
                        ".linea-central",
                        {
                            scaleY: 0,
                            duration: 0.4,
                            ease: "power2.in",
                            transformOrigin: "top center",
                        },
                        0,
                    )

                    .to(
                        ".corazon-item",
                        {
                            scale: 0,
                            duration: 0.4,
                            ease: "power2.in",
                        },
                        0,
                    )

                    .to(
                        ".imagen-izq, .texto-izq",
                        {
                            x: -60,
                            duration: 0.4,
                            ease: "power2.in",
                        },
                        0,
                    )

                    .to(
                        ".imagen-der, .texto-der",
                        {
                            x: 60,
                            duration: 0.4,
                            ease: "power2.in",
                        },
                        0,
                    );
            },
        });
    };

    document.addEventListener("DOMContentLoaded", initItinerario);
    document.addEventListener("astro:page-load", initItinerario);
</script>
