---
// ComponenteConfirmarAsistencia.astro
---

<section class="relative bg-[#FBF5EF] w-full mt-8 py-4 px-6 overflow-hidden">

    <!-- Hojas decorativas a la izquierda -->
    <div id="hojas-rsvp-izq" class="pointer-events-none absolute top-[38%] -left-6 sm:-left-7 md:-left-8 -translate-y-1/2 w-16 sm:w-20 md:w-24 z-0">
        <img
            src="/imagenes/hojas.webp"
            alt="Hojas decorativas"
            class="w-full h-auto object-contain"
                loading="lazy"
                decoding="async"
            />
    </div>

    <div class="relative z-10 max-w-lg mx-auto text-center">
        
        <!-- Título "Confirma tu Asistencia" -->
        <div id="titulo-asistencia" class="mb-6">
            <h3 class="font-great-vibes text-[clamp(2.1rem,8.8vw,3.5rem)] leading-tight text-[#A24F35] tracking-wide whitespace-nowrap">
                Confirma tu Asistencia
            </h3>
        </div>

        <!-- Texto explicativo -->
        <div id="texto-asistencia" class="mb-6">
            <p class="text-[#3B2A22] text-sm sm:text-base font-serif leading-relaxed">
                SERÁ DE MUCHA ALEGRÍA PARA NOSOTROS CONTAR<br />
                CON TU COMPAÑÍA EN ESTE DÍA TAN IMPORTANTE.
            </p>
        </div>

        <!-- Texto de confirmación -->
        <div id="texto-fecha-limite" class="mb-8">
            <p class="text-[#3B2A22] text-sm sm:text-base font-serif leading-relaxed">
                AGRADECEMOS CONFIRMAR TU ASISTENCIA
            </p>
            <p class="mt-2 text-[#A24F35] text-base sm:text-lg font-serif tracking-[0.15em]">
                +591 62361998
            </p>
        </div>

        <!-- Botón "CONFIRMAR ASISTENCIA" -->
      <!-- Botón "CONFIRMAR ASISTENCIA" -->
<div id="boton-asistencia">
    <a
        href="https://wa.me/59162361998?text=Me%20complace%20confirmar%20mi%20asistencia%20a%20la%20boda%20de%20Alex%20Sander%20y%20Luc%C3%ADa.%20Nos%20vemos%20el%20s%C3%A1bado%2003%20de%20octubre.%20%C2%A1Estar%C3%A9%20sin%20falta!"
        target="_blank"
        rel="noopener"
        class="group relative inline-block bg-[#A24F35] text-[#FBF5EF] px-10 py-3.5 rounded-lg text-sm sm:text-base font-serif uppercase tracking-[0.2em] hover:bg-[#7B3823] hover:-translate-y-0.5 transition-all duration-300 shadow-md hover:shadow-lg"
    >
        <span class="pointer-events-none absolute inset-1.5 rounded border border-white/30 transition-all duration-300 group-hover:inset-[7px]"></span>
        <span class="relative">Confirmar asistencia</span>
    </a>
</div>


    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {

        // ═══ HOJAS DECORATIVAS - Entrada lateral desde su propio lado ═══
        gsap.fromTo(
            "#hojas-rsvp-izq",
            { opacity: 0, x: -120, rotation: -6 },
            {
                opacity: 1,
                x: 0,
                rotation: 0,
                duration: 1.3,
                ease: "power3.out",
                scrollTrigger: { trigger: "#hojas-rsvp-izq", start: "top 92%", toggleActions: "play none none reverse" }
            }
        );
        console.log("✉️ Iniciando animaciones de confirmar asistencia...");

        // ═══ TÍTULO "CONFIRMA TU ASISTENCIA" ═══
        gsap.fromTo(
            "#titulo-asistencia",
            { opacity: 0, y: -30 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#titulo-asistencia",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ TEXTO EXPLICATIVO ═══
        gsap.fromTo(
            "#texto-asistencia",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#texto-asistencia",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.3
            }
        );

        // ═══ TEXTO FECHA LÍMITE ═══
        gsap.fromTo(
            "#texto-fecha-limite",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#texto-fecha-limite",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.5
            }
        );

        // ═══ BOTÓN "CONFIRMAR ASISTENCIA" ═══
        gsap.fromTo(
            "#boton-asistencia",
            { opacity: 0, scale: 0.8 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.8,
                ease: "back.out(1.5)",
                scrollTrigger: {
                    trigger: "#boton-asistencia",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.7
            }
        );

        console.log("✨ Animaciones de confirmar asistencia completadas!");
    });
</script>

<style>
    /* Efecto hover en el título */
    #titulo-asistencia:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    /* Animación del botón al hacer clic */
    #boton-asistencia a:active {
        transform: scale(0.95);
    }
</style>